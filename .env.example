# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up

# Neon PostgreSQL
DATABASE_URL=

# Local-only onboarding smoke test. Never set these in production.
DEV_AUTH_BYPASS_USER_ID=
DEV_AUTH_BYPASS_EMAIL=

# Cloudflare R2 (S3-compatible object storage)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Alternatively use R2_ENDPOINT/R2_ACCOUNT_ID, R2_BUCKET_NAME, R2_ACCESS_KEY_ID, and R2_SECRET_ACCESS_KEY.
